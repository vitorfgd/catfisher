{
  "name": "grumpiest-catch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:ts": "tsc --noEmit",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "check:invariants": "tsx scripts/check-invariants.ts",
    "check:port": "tsx scripts/check-port-readiness.ts",
    "check": "npm run check:ts && npm run check:scripts && npm run check:invariants && npm run check:port",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.0"
  }
}
